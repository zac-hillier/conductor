[Unit]
Description=Conductor scheduler (schedule:work — dispatch tick + recovery)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zac/conductor
Environment=PATH=/home/zac/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/php /home/zac/conductor/artisan schedule:work
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
